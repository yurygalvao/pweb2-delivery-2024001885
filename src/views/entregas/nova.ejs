<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>+ Nova Entrega</h2>
</div>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
    <% errors.forEach(err => { %>
      <div><%= err.msg %></div>
    <% }) %>
  </div>
<% } %>

<form action="/entregas" method="POST" class="card card-body shadow-sm">
  <div class="mb-3">
    <label class="form-label fw-bold">Descrição</label>
    <input type="text" name="descricao" class="form-control" value="<%= typeof dados !== 'undefined' ? dados.descricao || '' : '' %>" required placeholder="Ex: Encomenda de Eletrônicos">
  </div>

  <div class="mb-3">
    <label class="form-label fw-bold">Origem</label>
    <input type="text" name="origem" class="form-control" value="<%= typeof dados !== 'undefined' ? dados.origem || '' : '' %>" required placeholder="Ex: Galpão Central">
  </div>

  <div class="mb-3">
    <label class="form-label fw-bold">Destino</label>
    <input type="text" name="destino" class="form-control" value="<%= typeof dados !== 'undefined' ? dados.destino || '' : '' %>" required placeholder="Ex: Av. Paulista, 1000">
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Salvar Entrega</button>
    <a href="/entregas" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
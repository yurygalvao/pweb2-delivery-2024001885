<div class="container mt-4">
  <h2>+ Novo Motorista</h2>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
      <% errors.forEach(err => { %>
        <div><%= err.msg %></div>
      <% }) %>
    </div>
  <% } %>

  <form action="/motoristas" method="POST" class="card card-body shadow-sm mt-3">
    <div class="mb-3">
      <label class="form-label fw-bold">Nome</label>
      <input type="text" name="nome" class="form-control" value="<%= typeof dados !== 'undefined' ? dados.nome || '' : '' %>" required placeholder="Ex: João Silva">
    </div>

    <div class="mb-3">
      <label class="form-label fw-bold">CPF</label>
      <input type="text" name="cpf" class="form-control" value="<%= typeof dados !== 'undefined' ? dados.cpf || '' : '' %>" required placeholder="Ex: 123.456.789-00">
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Salvar Motorista</button>
      <a href="/motoristas" class="btn btn-secondary">Cancelar</a>
    </div>
  </form>
</div>